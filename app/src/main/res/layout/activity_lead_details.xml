<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Lead Details"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- VIEW MODE: Clean CardView Layout -->
            <LinearLayout
                android:id="@+id/layoutViewMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvViewName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Pengyu Chen" />

                        <!-- Icon Action Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- Phone Container -->
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/ivPhoneIcon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="8dp"
                                    android:src="@android:drawable/stat_sys_phone_call"
                                    app:tint="?attr/colorPrimary" />
                            </FrameLayout>

                            <!-- SMS Container -->
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/ivSmsIcon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="8dp"
                                    android:src="@android:drawable/sym_action_chat"
                                    app:tint="?attr/colorPrimary" />
                            </FrameLayout>

                            <!-- Email Container -->
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <ImageView
                                    android:id="@+id/ivEmailIcon"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="8dp"
                                    android:src="@android:drawable/ic_dialog_email"
                                    app:tint="?attr/colorPrimary" />
                            </FrameLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvViewAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="#666666"
                            tools:text="123 Main St, Vancouver, BC" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vehicle Interest" android:textColor="?attr/colorPrimary" android:textStyle="bold" />
                        <TextView android:id="@+id/tvViewVehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" tools:text="2024 VW Tiguan"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notes" android:textColor="?attr/colorPrimary" android:textStyle="bold" />
                        <TextView android:id="@+id/tvViewNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" tools:text="Follow up next week."/>
                        <TextView android:id="@+id/tvDetUpdatedDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="11sp" android:textColor="#999999" />
                        <TextView android:id="@+id/tvDetDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#999999" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Scientific Timeline Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tasks &amp; Activities"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvLeadTimeline"
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:scrollbars="vertical"
                            android:fadeScrollbars="false"
                            android:nestedScrollingEnabled="true"
                            tools:listitem="@layout/item_timeline"
                            tools:itemCount="5" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- EDIT MODE: Form Layout (Includes Delete Button) -->
            <LinearLayout
                android:id="@+id/layoutEditMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <EditText android:id="@+id/etDetFirstName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="First Name" />
                <EditText android:id="@+id/etDetLastName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Last Name" />
                <EditText android:id="@+id/etDetPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Phone" android:inputType="phone" />
                <EditText android:id="@+id/etDetEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vehicle" android:layout_marginTop="12dp" android:textStyle="bold"/>
                <EditText android:id="@+id/etDetMake" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Make" />
                <EditText android:id="@+id/etDetModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Model" />
                <EditText android:id="@+id/etDetYear" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Year" android:inputType="number" />
                <EditText android:id="@+id/etDetTrim" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Trim" />
                <EditText android:id="@+id/etDetNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Notes" android:layout_marginTop="12dp" android:lines="3" android:gravity="top"/>

                <Button android:id="@+id/btnUpdateLead" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save Changes" android:layout_marginTop="16dp" />

                <!-- Delete Button only visible in Edit Mode -->
                <Button android:id="@+id/btnDeleteLead"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Delete Lead"
                    android:textColor="@android:color/holo_red_dark" />
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>